# type: ignore
import time
from datetime import datetime
from scp import SCPNode, combine
from client import Client
import quorum
from node_manager import NodeManager

STATE_FIELDS = ('slot', 'n', 'X', 'Y', 'Z', 'phi', 'b', 'p', 'p2', 'c', 'h', 'z')

class CState:
  def __init__(self, state):
    for f in STATE_FIELDS:
      v = getattr(state, f)
      setattr(self, f, frozenset(v) if isinstance(v, set) else v)

class SCPNodeC(process, SCPNode):
  def setup(D, peers, checker, name, debugNames, log_file, test_id, crashed=False, slow=None, slow_until=0, logs_dir='test_logs'):
    super().setup(D, peers, name, debugNames, log_file, logs_dir, crashed)
    self.test_id = test_id

  ## slow only until slow_until (end of the case) so the backlog drains fast enough to handle 'terminate'
  def receive(msg=m):
    if slow and m[0] in self.protocol_messages and time.time() < slow_until:
      delay, slots, types = slow
      if m[2] in slots and m[0] in types:
        time.sleep(delay)

  def send(msg, to, debugOnly=False, withLog=None):
    if checker in to:
      msg = (self.test_id,) + msg
    elif msg[0] in self.protocol_messages and msg[1] == self:
      send(('state', msg[2], msg, CState(self.state_per_slot[msg[2]]), logical_clock(), time.time()), to={ checker })
    super().send(msg, to=to, debugOnly=debugOnly, withLog=withLog)

  def arm_timer(state, kind, duration):
    super().arm_timer(state, kind, duration)
    if kind == 'ballot':
      send(('armed', state.slot, state.b.n, logical_clock(), time.time()), to={ checker })

  def increment_ballot(state):
    send(('fired', state.slot, state.b.n, logical_clock(), time.time()), to={ checker })
    super().increment_ballot(state)

  def receive(msg=('terminate',), from_=checker):
    send(('done',), to={ checker })
    exit()

  def run():
    send(('ready',), to={ checker })
    super().run()

## runs one case and sends ('results', name, timed_out, intact names, per-slot (slot, checks, stats)) to its parent
class Checker(process, Client, NodeManager):
  def setup(name, quorum_config, nslots, crashed, slow, case_timeout):
    super().setup()
    self.name = name
    self.log_file = f'scp_log_{datetime.now().strftime("%Y%m%dT%H%M%S")}.txt'
    self.test_id = 1
    self.intact_set = set()

  def output(s):
    super().output(f'[{self.name}] {s}')

  def run():
    slot_range = range(1, nslots + 1)
    slow_until = time.time() + case_timeout
    spawn_nodes(quorum_config, SCPNodeC, test_id, log_file, crashed, {n: (spec, slow_until) for n, spec in slow.items()})
    # Definition (intact). A node v in an FBAS is intact iff there exists a DSet B containing
    # all ill-behaved nodes and such that v ∉ B.
    ## crashed nodes are the only ill-behaved nodes for now
    self.intact_set = quorum.intact_set(self.node_Ds, self.crashed_nodes)
    send_all_different(slot_range, self.nodes)
    timed_out = False
    if await(each(i in slot_range, has=validate_nomination(i) and theorem_12(i) and all_externalized(i))): pass
    elif timeout(case_timeout): timed_out = True
    results = tuple(slot_results(i) for i in slot_range)
    intact = tuple(sorted(debug_names[str(v)] for v in self.intact_set))
    teardown_nodes()
    send(('results', name, timed_out, intact, results), to=parent())

  def slot_results(i):
    armed = setof((v, n, t), received((_test_id, 'armed', _i, n, _, t), from_=v))
    checks = (('validate_nomination', validate_nomination(i)), ('theorem_12', theorem_12(i)), ('theorem_13', theorem_13(i)),
              ('theorem_14', theorem_14(i)), ('theorem_15', theorem_15(i)), ('theorem_16', theorem_16(i)))
    stats = (('externalized', len(externalized(i))), ('distinct', len(setof(x, (_, x) in externalized(i)))),
             ('armed', len(armed)), ('fired', len(setof(t, received((_test_id, 'fired', _i, _, _, t))))),
             ('max_armed_n', int(max(setof(n, (_, n, _) in armed) | {0}))), ('confirm', len(confirmed(i))))
    return (int(i), checks, stats)

  # Intact nodes can produce at least one candidate value for slot i.
  def validate_nomination(i):
    return each(n in self.intact_set, has=
      some(received((_test_id, 'state', _i, _, s, _, _), from_=_n), has=s.Z))

  # Theorem 12. Eventually, all intact nodes will have the same composite value.
  ## ?? paper's definition of intact nodes doesn't enforce quorum intersection...
  def theorem_12(i):
    return len(setof(combine(s.Z), n in self.intact_set,
      received((_test_id, 'state', _i, _, s, lc, _), from_=_n),
      lc == maxof(lc2, received((_test_id, 'state', _i, _, _, lc2, _), from_=_n)))) <= 1

  # THEOREM 13. Let ⟨V1, Q1⟩, … , ⟨Vk, Qk⟩ be the set of configurations an FBAS has
  # experienced during agreement on a single slot. Let V = V1 ∪ ⋯ ∪ Vk and Q(v) = { q ∣
  # ∃j such that v ∈ Vj ∧ q ∈ Qj(v) }. Let B ⊆ V be a set such that B contains all ill-
  # behaved nodes that have sent illegal messages, though V ⧵ B may still contain crashed
  # (unresponsive) nodes. Suppose nodes v1 and v2 are well-behaved, v1 externalizes x1 for
  # the slot, and v2 externalizes x2. If ⟨V, Q⟩B enjoys quorum intersection, then x1 = x2
  ## Assuming no ill-behaved nodes for now
  def theorem_13(i):
    
    Qs = setof((n, m[-1]), n in self.nodes.values(),
      received((_test_id, 'state', _i, m, _, _, _), from_=_n)) | set(self.node_Ds.items())
    
    V_Q = {}
    for v in setof(v, (v, _) in Qs):
      Ds = setof(D, (_v, D) in Qs)
      V_Q[v] = next(iter(Ds)) if len(Ds) == 1 else (1, frozenset(Ds))
    
    if not quorum.has_quorum_intersection(V_Q):
      output(f'theorem_13({i}): no quorum intersection, inapplicable')
      return True
    
    return len(setof(x, (_, x) in externalized(i))) <= 1

  # THEOREM 14. In an FBAS with quorum intersection, if no intact node is in the
  # EXTERNALIZE phase and an intact node with ballot ⟨n, x⟩ arms its timer as described
  # in Section 6.2.2, then, given sufficient communication, every intact node v can set b_v ≥ n
  # before any timer fires
  ## "any timer" = a timer armed at counter >= n; a lagging node's leftover lower-counter timer firing is it catching up
  def theorem_14(i):

    def first_fired_after(t_arm, n):
      return min(setof(t, v in self.intact_set, received((_test_id, 'fired', _i, n2, _, t), from_=_v), t > t_arm, n2 >= n) | {float('inf')})
    
    if not quorum.has_quorum_intersection(self.node_Ds):
      output(f'theorem_14({i}): no quorum intersection, inapplicable')
      return True
    
    return each(u in self.intact_set, has=
      each(received((_test_id, 'armed', _i, n, _, t_arm), from_=_u), has=
        some(v in self.intact_set, has=some(received((_test_id, 'state', _i, _, s, _, t), from_=_v), has=s.phi == 'EXTERNALIZE' and t <= t_arm))
        or each(v in self.intact_set, has=
          some(received((_test_id, 'state', _i, _, s, _, t), from_=_v), has=s.b.n >= n and t <= first_fired_after(t_arm, n)))))

  # THEOREM 15. Given long enough timeouts, if an intact node has reached the CONFIRM
  # phase with b.x = x, then eventually all intact nodes will terminate
  def theorem_15(i):
    return not confirmed(i) or all_externalized(i)

  # THEOREM 16. Regardless of past ill-behavior, given long enough timeouts and periods in
  # which ill-behaved nodes do not send new messages, intact nodes running SCP will terminate
  ## crashed nodes are the only ill-behaved nodes for now, and they never send
  def theorem_16(i):
    return all_externalized(i)

  def confirmed(i):
    return setof(v, v in self.intact_set, some(received((_test_id, 'state', _i, _, s, _, _), from_=_v), has=s.phi == 'CONFIRM'))

  def all_externalized(i):
    return each(n in self.intact_set, has=some((_n, _) in externalized(i)))

  def externalized(i):
    return setof((n, s.c.x), n in self.nodes.values(),
      received((_test_id, 'state', _i, _, s, _, _), from_=_n), s.phi == 'EXTERNALIZE')
