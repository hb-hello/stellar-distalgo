from utils import hash_msg, replace_node_ids, log_to_file

class Node(process):
  def setup(name, debugNames, log_file):
    self.name = name
    self.debug_names = debugNames  ## maps str(node id) -> node name, so output() can de-anonymize ids in log lines
    self.peers = {}
    self.gossip_known = {}
    self.protocol_messages = set()  ## subclasses override this to the set of message types that should be gossip-tracked
    output(f'Node {self} initialized')

  def output(s):
    super().output(f'[{self.name}] {replace_node_ids(s, self.debug_names)}')

  def log(s):
    if s: log_to_file(self.log_file, s, self.debug_names)

  def send(msg, to, debugOnly=False, withLog=None):
    if msg[0] in self.protocol_messages:
      to = to - self.gossip_known.setdefault(hash_msg(msg), set())
      self.gossip_known[hash_msg(msg)] |= to
    output(f'Sending message: {msg} to peers: {to}')
    if not debugOnly: 
      if to and withLog: log(withLog)
      elif not to and withLog: log(f'deduped message not sending - {withLog}')
      super().send(msg, to=to)

  def receive(msg=m):
    output(f'received a message: {m}')
    if m[0] in self.protocol_messages:
      h = hash_msg(m)
      already_seen = h in gossip_known
      gossip_known.setdefault(h, set()).add(m[1])
      sender, D = m[1], m[-1]
      peers[sender] = D
      for node in setof(n, (_, v) in D[1], n in v):
        peers.setdefault(node, None)
      if not already_seen:
        send(m, to=peers.keys() - {self, sender})

  def run():
    await(False)
