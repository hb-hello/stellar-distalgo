import time
from threading import Timer
import hashlib
from datetime import datetime
from state import Ballot, State, INFINITY
from node import Node
import quorum

TIMEOUT = 1

PROTOCOL_MESSAGES = {'NOMINATE', 'PREPARE', 'CONFIRM', 'EXTERNALIZE'}

# Nodes then deterministically combine these candidates into a single composite value
# for the slot. Exactly how to combine values depends on the application
## to be defined based on application later on
def combine(values:set):
  return frozenset(values)

# Let gi(m) = H(i, xi−1, m) be a slot-specific hash
# function for slot i, where xi−1 is the value chosen for the slot preceding i (or the sorted
# set of values of all immediate dependencies of slot i when slots are governed by a par-
# tial order).
def gi(i, xi_minus_1, m):
  # For simplicity, we can use a hash of the concatenation of the inputs as a placeholder for the slot-specific hash function.
  # In a real implementation, this should be a secure hash function that takes into account the specific requirements of the protocol.
  input_str = f"{i}:{xi_minus_1}:{m}"
  return hashlib.sha256(input_str.encode()).hexdigest()

def neighbors(qc, peers, n, i):
  # neighbors(v, n) = { v2 | gi(N, n, v2) < h_max * weight(v, v2) }
  h_max = 2 ** 256  # Maximum value for a 256-bit hash
  N = 1 # N and P are constants to produce two different hash functions.
  ## qc.members is every validator in qc.v's own D (qc.weight is 0 for anything else);
  ## peers maps the str ids qc works in back to real process ids
  by_str = {str(p): p for p in peers}
  return setof(by_str[v2], v2 in qc.members, int(gi(i, 0, f"{N}:{n}:{v2}"), 16) < h_max * qc.weight(v2)) ## pass 0 in place of xi_minus_1 for now

def priority(n, v2):
  # priority(n, v2) = gi(P, n, v2)
  P = 2 # N and P are constants to produce two different hash functions.
  return int(gi(P, 0, f"{P}:{n}:{v2}"), 16) ## pass 0 in place of xi_minus_1 for now

def max_priority_neighbor(qc, peers, n, i):
  neighbors_set = neighbors(qc, peers, n, i)
  if not neighbors_set:
    return None
  return max((priority(n, v2), v2) for v2 in neighbors_set)[1]

class SCPNode(process, Node):
  def setup(D:tuple, peers, name, debugNames, log_file, logs_dir='logs', crashed=False):
    # D is node v’s quorum slice Q(v) or a collision-resistant hash of Q(v)
    super().setup(peers, name, debugNames, log_file, logs_dir, crashed)
    self.protocol_messages = PROTOCOL_MESSAGES
    self.state_per_slot = dict()  ## To maintain the state per slot #? should this be a set instead of dict?
    self.qc = quorum.QuorumChecker(str(self), D)
    ## map of peers (node ids and their quorum config) based on quorum slices
    for node in quorum.validators(D):
      self.peers[node] = None
    self.peers[self] = D
    self.ballot_timer_n = {} ## slot -> b.n when ballot timer armed
    # output(f'Node {self} initialized with quorum slices: {D} and peers: {self.peers}')

  def receive(msg=m):
    if self.crashed: return
    if m[0] in self.protocol_messages:
      self.qc.add(str(m[1]), m[-1])

  def receive(msg=('TRANSACTION', i, value)):
    if self.crashed: return
    # This is a message from a client adding a value for slot i.
    is_new_slot = i not in self.state_per_slot
    state = self.state_per_slot.setdefault(i, State(i, self.D)) ## retrieve or initialize the state for mentioned slot
    if update_nomination_state(state):
      send_nomination(state)
    if is_new_slot: arm_timer(state, 'nomination', TIMEOUT)

  def send_nomination(state:State):
    # NOMINATE v i X Y D
    # This is a message from node v nominating values for slot i. D is v’s quorum
    # slice Q(v) or a collision-resistant hash of Q(v). X and Y are from v’s state.

    # Only one remote procedure call (RPC) is needed for nomination - the argument is the
    # sender’s latest NOMINATE message and the return value is the receiver’s.
    msg = ('NOMINATE', self, state.slot, frozenset(state.X), frozenset(state.Y), self.D)
    send(msg, to=self.peers.keys() - {self}, withLog=f'{self} nominating with X={state.X}, Y={state.Y} for slot {1 if state.slot is True else state.slot}, round {state.n}')

  def increment_n(state:State):
    # v should use timeouts to decide on new nominate statements to vote for. After n timeouts, v should
    # find a node v_n ∈ neighbors(v, n) maximizing priority(n, v_n) and vote to nominate every-
    # thing v_n has voted to nominate
    # As soon as v has a candidate value, however, it must cease voting to nominate x
    # for any new values x
    if state.Z: return
    ## keep trying to nominate new values by incrementing the round number (n)
    state.n += 1
    state.v_n = max_priority_neighbor(self.qc, self.peers, state.n, state.slot)
    if update_nomination_state(state): send_nomination(state) ## send nomination request message to peers for this slot based on updated n
    arm_timer(state, 'nomination', TIMEOUT)

  def update_nomination_state(state:State):
    # Each node v should initially find a node v0 ∈ neighbors(v, 0) that maximizes
    # priority(0, v0) among nodes it can communicate with, then vote to nominate the same
    # values as v0. Only if v = v0 should v introduce a new value to nominate.
    if state.v_n is None: state.v_n = max_priority_neighbor(self.qc, self.peers, state.n, state.slot)
    ## new value to nominate is picked from transactions received
    had_X, had_Z = bool(state.X), bool(state.Z)
    if state.v_n == self:
      state.X |= setof(x, received(('TRANSACTION', state.slot, x))) ## adding new values to vote for nominations
    else:
      state.X |= setof(x, (v, Xm, _, _) in state.N, v == state.v_n, x in Xm) ## echoing current leader's nominate votes

    state.Y |= setof(x, (_, Xm, Ym, _) in nominations(state), x in Xm | Ym, accepts_nominate(state, x))
    
    # A node v considers a value x to be a candidate when v has
    # confirmed the statement nominate x—i.e., v has ratified accept (nominate x).
    # move values from Y to Z based on candidate criteria
    state.Z |= setof(x, x in state.Y, confirms_nominate(state, x))

    # Because nodes cannot tell when the nomination protocol is complete anyway, SCP
    # must cope with different composite values at different nodes. As an optimization, then,
    # nodes can attempt to predict the final composite value before they even have a candi-
    # date value. To do this, the composite value can be taken as combine(Z) when Z ≠ <empty set>,
    # otherwise combine(Y) when Y ≠ <empty set>, otherwise combine(X) when X ≠ <empty set>. This means the
    # highest-priority node can optimistically initiate balloting at the same time as nom-
    # ination, piggybacking its first ballot message PREPARE (described below) on its first
    # NOMINATE message.
    if state.h.n == 0:
      state.z = combine(state.Z) if state.Z else (combine(state.Y) if state.Y else combine(state.X))

    # highest-priority node can optimistically initiate balloting at the same time as nom-
    # ination, piggybacking its first ballot message PREPARE (described below) on its first
    # NOMINATE message.
    if not had_X and state.X and state.v_n == self: send_message(state)

    if not had_Z and state.Z:
      log(f'{self} now has candidate value Z={state.Z} for slot {state.slot}')
      send_message(state)

    return state.add_nomination(self, frozenset(state.X), frozenset(state.Y), self.D)

  def receive(msg=('NOMINATE', sender, i, X, Y, D)):
    if self.crashed: return
    is_new_slot = i not in self.state_per_slot
    state = self.state_per_slot.setdefault(i, State(i, self.D)) ## retrieve the state for mentioned slot

    ## Ignore if this is not a new nomination message
    if not state.add_nomination(sender, X, Y, D): return

    #c nodes broadcast their state whenever there is an update in state
    if update_nomination_state(state):
      send_nomination(state)
    if is_new_slot: arm_timer(state, 'nomination', TIMEOUT)

  def nominations(state):
    return state.N | {(self, frozenset(state.X), frozenset(state.Y), self.D)}

  def voted_nominate(state, x):
    # This concrete message encodes the following conceptual messages:
    # — { nominate x ∣ x ∈ X } (votes to nominate each value in X)
    # — { accept (nominate x) ∣ x ∈ Y } (votes to confirm nominations in Y)
    return setof(str(v), (v, Xm, Ym, _) in nominations(state), x in Xm or x in Ym)

  def accepted_nominate(state, x):
    return setof(str(v), (v, _, Ym, _) in nominations(state), _x in Ym)

  # Definition (accept). An FBAS node v accepts a statement a iff it has never accepted
  # a statement contradicting a and it determines that either
  # (1) There exists a quorum U such that v ∈ U and each member of U either voted for
  # a or claims to accept a, or
  # (2) Each member of a v-blocking set claims to accept a
  def accepts_nominate(state, x):
    return qc.quorum(voted_nominate(state, x)) or qc.v_blocking(accepted_nominate(state, x))

  # Definition (confirm). A quorum U_a in an FBAS confirms a statement a iff ∀v ∈ U_a,
  # v claims to accept a. A node confirms a iff it is in such a quorum.
  def confirms_nominate(state, x):
    return qc.quorum(accepted_nominate(state, x))

  # Fig. 17. Messages in SCP’s ballot protocol
  def send_message(state):
    # Once z ≠ ⊥, if b.n = 0, a node
    # reinitializes b to ⟨1, z⟩ to start sending messages. Nodes then repeatedly exchange
    # messages with peers, sending whichever ballot message is indicated by phi.
    if not state.z: return
    if state.b.n == 0 or not state.b.x:
      state.b = Ballot(n=max(state.b.n, 1), x=state.z)

    if state.phi == 'PREPARE':
      # PREPARE v i b p p2 c.n h.n D
      # This is a message from node v about slot i. D specifies Q(v). The other fields
      # reflect v’s state. Values c.x and h.x are elided as c.x = h.x = b.x when c.n ≠ 0.
      msg = ('PREPARE', self, state.slot, (state.b, state.p, state.p2, state.c.n, state.h.n), self.D)
      if state.add_message(msg):
        send(msg, to=self.peers.keys() - {self}, withLog=f'{self} preparing ballot b={state.b} for slot {state.slot}')

    elif state.phi == 'CONFIRM':
      # CONFIRM v i b p.n c.n h.n D
      # Sent by v to try to externalize b.x for slot i after accepting a commit. Implies
      # p.x = c.x = h.x = b.x in v’s state. For convenience, we also say p2 = 0 (p2 is
      # irrelevant after accepting commit). D specifies Q(v) as above.
      msg = ('CONFIRM', self, state.slot, (state.b, state.p.n, state.c.n, state.h.n), self.D)
      if state.add_message(msg):
        send(msg, to=self.peers.keys() - {self})

    elif state.phi == 'EXTERNALIZE':
      # EXTERNALIZE v i x c.n h.n D
      # After v confirms commit ⟨c.n,x⟩ for slot i and externalizes value x, this
      # message helps other nodes externalize x. Implies c = ⟨c.n, x⟩ and h = ⟨h.n, x⟩.
      # For convenience, we also say b = p = h = ⟨infinity, x⟩, and p2 = 0.
      msg = ('EXTERNALIZE', self, state.slot, (state.b.x, state.c.n, state.h.n), self.D)
      if state.add_message(msg):
        send(msg, to=self.peers.keys() - {self})

    ## In section 6.2.2 in the paper
    # For this reason, nodes employ a timer as follows:
    # (a) A node v with phi_v ≠ EXTERNALIZE arms a timer whenever ∃S ⊆ M_v such that
    # the set of senders U = { v_m ∣ m ∈ S } is a quorum, v ∈ U, and ∀m ∈ S, b_m.n ≥ b_v.n.
    U = setof(str(vm), (t, vm, _, f, _) in state.M, (INFINITY if t == 'EXTERNALIZE' else f[0].n) >= state.b.n)
    if state.phi != 'EXTERNALIZE' and self.ballot_timer_n.get(state.slot) != state.b.n and str(self) in U and qc.quorum(U):
      self.ballot_timer_n[state.slot] = state.b.n
      arm_timer(state, 'ballot', TIMEOUT * state.b.n)

  
  def voted_prepare(state, ballot):
    ## all nodes with prepare b greater than and compatible with this ballot have voted to prepare this ballot
    return (setof(str(vm), ('PREPARE', vm, _, f, _) in state.M, (bm, _, _, _, _) in {f}, bm.gt_c(ballot))
      ## confirm b represents prepare INFINITY, b.x which counts as a vote to prepare all compatible ballots
      | setof(str(vm), ('CONFIRM', vm, _, f, _) in state.M, (bm, _, _, _) in {f}, bm.x == ballot.x)
      ## externalize x represents prepare INFINITY, x which counts as a vote to prepare all compatible ballots
      | setof(str(vm), ('EXTERNALIZE', vm, _, f, _) in state.M, (xm, _, _) in {f}, xm == ballot.x)
      ## accepting also counts toward the quorum in accept's clause (1)
      | accepted_prepare(state, ballot))

  def accepted_prepare(state, ballot):
    ## all nodes with prepare p or p2 greater than and compatible with this ballot have accepted this ballot as prepared
    return (setof(str(vm), ('PREPARE', vm, _, f, _) in state.M, (_, pm, p2m, _, _) in {f}, pm.gt_c(ballot) or p2m.gt_c(ballot))
      ## confirm b p_n represents prepare with p as (p_n, b.x), similar to above these have accepted this ballot as prepared
      | setof(str(vm), ('CONFIRM', vm, _, f, _) in state.M, (bm, p_nm, _, _) in {f}, Ballot(p_nm, bm.x).gt_c(ballot))
      ## externalize x represents prepare with p as INFINITY, similar to above these have accepted this ballot as prepared
      | setof(str(vm), ('EXTERNALIZE', vm, _, f, _) in state.M, (xm, _, _) in {f}, xm == ballot.x))

  def accepts_prepare(state, ballot):
    return qc.quorum(voted_prepare(state, ballot)) or qc.v_blocking(accepted_prepare(state, ballot))

  def confirms_prepare(state, ballot):
    return qc.quorum(accepted_prepare(state, ballot))

  def voted_commit(state, ballot):
    ## all nodes with prepare b, c, h represent the below vote commit for a ballot between c and h
    # — {commit b2 ∣ c.n ≠ 0 ∧ c ≲ b2 ≲h} (a vote to commit c,…,ℎ if c ≠ 0)
    return (setof(str(vm), ('PREPARE', vm, _, f, _) in state.M, (bm, _, _, c_nm, h_nm) in {f}, c_nm != 0, bm.x == ballot.x, c_nm <= ballot.n <= h_nm)
      ## confirm implies prepare b, c, INFINITY, all nodes with c less than ballot vote commit on ballot
      | setof(str(vm), ('CONFIRM', vm, _, f, _) in state.M, (bm, _, c_nm, _) in {f}, bm.x == ballot.x, c_nm <= ballot.n)
      ## externalize implies the same as above
      | setof(str(vm), ('EXTERNALIZE', vm, _, f, _) in state.M, (xm, c_nm, _) in {f}, xm == ballot.x, c_nm <= ballot.n)
      ## accepting also counts toward the quorum in accept's clause (1)
      | accepted_commit(state, ballot))

  def accepted_commit(state, ballot):
    ## all nodes with confirm b, c, h represent below accept commit for ballot between c and h
    # — {accept(commit b2 ) ∣ c ≲ b2 ≲h} (a vote to confirm commit c,…, h)
    return (setof(str(vm), ('CONFIRM', vm, _, f, _) in state.M, (bm, _, c_nm, h_nm) in {f}, bm.x == ballot.x, c_nm <= ballot.n <= h_nm)
      ## externalize x, c implies confirm b, c, INFINITY, all nodes with c less than ballot accepted commit for it
      | setof(str(vm), ('EXTERNALIZE', vm, _, f, _) in state.M, (xm, c_nm, _) in {f}, xm == ballot.x, c_nm <= ballot.n))

  # For a given ballot, commit and abort are contradictory, so a well-behaved node may vote for at most one
  # of them.
  # Definition (prepared). A ballot b is prepared iff every statement in the following set
  # is true: { abort b_old ∣ b_old ⋦ b }.
  ## accepting p (or p2) prepared accepts abort b for every b ⋦ p
  def contradicts_commit(state, ballot):
    return state.p.gt_nc(ballot) or state.p2.gt_nc(ballot)

  def accepts_commit(state, ballot):
    if contradicts_commit(state, ballot): return False
    return qc.quorum(voted_commit(state, ballot)) or qc.v_blocking(accepted_commit(state, ballot))

  def confirms_commit(state, ballot):
    return qc.quorum(accepted_commit(state, ballot))

  ## v accepts all { commit b2 ∣ lo ≲ b2 ≲ hi }
  def accepts_commit_range(accepted, points, lo, hi):
    return each(b2 in points, has=not (lo.lt_c(b2) and b2.lt_c(hi)) or b2 in accepted)

  ## commit ballots where some sender's commit range starts, ends, or has just ended, plus where the
  ## p/p2 contradiction stops - accepting commit can only change at these, so checking them stands in for checking every counter
  def commit_points(state):
    points = (setof(Ballot(n, bm.x), ('PREPARE', _, _, f, _) in state.M, (bm, _, _, c_nm, h_nm) in {f}, c_nm != 0, n in {c_nm, h_nm, min(h_nm + 1, INFINITY)})
      | setof(Ballot(n, bm.x), ('CONFIRM', _, _, f, _) in state.M, (bm, _, c_nm, h_nm) in {f}, c_nm != 0, n in {c_nm, h_nm, min(h_nm + 1, INFINITY)})
      | setof(Ballot(n, xm), ('EXTERNALIZE', _, _, f, _) in state.M, (xm, c_nm, _) in {f}, n in {c_nm, INFINITY}))
    return points | setof(Ballot(q.n + 1, b.x), b in points, q in {state.p, state.p2}, q.n != 0, q.n < INFINITY)

  def prepare_points(state):
    return (setof(q, ('PREPARE', _, _, f, _) in state.M, (bm, pm, p2m, _, _) in {f}, q in {bm, pm, p2m})
      | setof(q, ('CONFIRM', _, _, f, _) in state.M, (bm, p_nm, _, _) in {f}, q in {Ballot(INFINITY, bm.x), Ballot(p_nm, bm.x)})
      | setof(Ballot(INFINITY, xm), ('EXTERNALIZE', _, _, f, _) in state.M, (xm, _, _) in {f}))

  ## every counter up to one past the highest finite counter in play, plus INFINITY - nothing changes in between
  def commit_points_all(state):
    values = setof(f[0] if t == 'EXTERNALIZE' else f[0].x, (t, _, _, f, _) in state.M)
    counters = setof(n, (_, _, _, f, _) in state.M, n in f[-2:]) | {state.p.n, state.p2.n, state.b.n}
    top = maxof(n, n in counters, n < INFINITY)
    return setof(Ballot(n, x), x in values, n in set(range(1, top + 2)) | {INFINITY})


  def receive(msg=('PREPARE', v, i, (b, p, p2, c_n, h_n), D)):
    if self.crashed: return
    state = self.state_per_slot.setdefault(i, State(i, self.D)) ## retrieve or initialize the state for mentioned slot
    statements = set()

    if not state.add_message(('PREPARE', v, i, (b, p, p2, c_n, h_n), D)): return ## Ignore if this is not a new message

    # This concrete message encodes a host of conceptual statements, as follows:
    # — {abort b2 ∨ accept(abort b2 ) ∣ b2 ⋦ b} (a vote to prepare b)
    # — {accept(abort b2 ) ∣ b2 ⋦ p} (a vote to confirm p is prepared)
    # — {accept(abort b2 ) ∣ b2 ⋦ p2 } (a vote to confirm p2 is prepared)
    # — {commit b2 ∣ c.n ≠ 0 ∧ c ≲ b2 ≲h} (a vote to commit c,…,ℎ if c ≠ 0)

    if state.phi in ('PREPARE', 'CONFIRM'):
      update_state(state)
      send_message(state)

  def receive(msg=('CONFIRM', v, i, (b, p_n, c_n, h_n), D)):
    if self.crashed: return
    state = self.state_per_slot.setdefault(i, State(i, self.D)) ## retrieve or initialize the state for mentioned slot

    if not state.add_message(('CONFIRM', v, i, (b, p_n, c_n, h_n), D)): return ## Ignore if this is not a new message

    # Encodes:
    # — Everything implied by PREPARE v i ⟨infinity,b.x⟩ p 0 c.n infinity D
    # — {accept(commit b2 ) ∣ c ≲ b2 ≲h} (a vote to confirm commit c,…, h)

    if state.phi in ('PREPARE', 'CONFIRM'):
      update_state(state)
      send_message(state)

  def receive(msg=('EXTERNALIZE', v, i, (x, c_n, h_n), D)):
    if self.crashed: return
    state = self.state_per_slot.setdefault(i, State(i, self.D)) ## retrieve or initialize the state for mentioned slot

    if not state.add_message(('EXTERNALIZE', v, i, (x, c_n, h_n), D)): return ## Ignore if this is not a new message

    # Encodes:
    # — Everything implied by CONFIRM v i ⟨infinity, x⟩ infinity c.n infinity D
    # — Everything implied by CONFIRM v i ⟨infinity, x⟩ infinity c.n h.n {{v}}

    if state.phi in ('PREPARE', 'CONFIRM'):
      update_state(state)
      send_message(state)

  def update_state(state):
    if state.phi == 'PREPARE':
      # (1) If phi = PREPARE and m lets v accept new ballots as prepared, update p and p2.
      ## find all ballots that could be accepted prepared due to this message
      ## ballots <= and ~ b and > own p2.n and not lt_c(own p) check if any are accepted?
      if some(ballot in prepare_points(state), has=ballot.n > state.p2.n and not ballot.lt_c(state.p) and accepts_prepare(state, ballot)):
        ## p2 and p are the 2 highest ballots accepted as prepared such that p2.lt_nc(p)
        if ballot.gt_nc(state.p):
          state.p2 = state.p
          state.p = ballot
        elif ballot.gt_c(state.p):
          state.p = ballot
        elif ballot > state.p2: state.p2 = ballot

      # Afterwards, if either p ⋧ h or p2 ⋧ h, then set c to 0
      if state.p.gt_nc(state.h) or state.p2.gt_nc(state.h): state.c = Ballot()

      # (2) If phi = PREPARE and m lets v confirm new higher ballots prepared, then raise h
      # to the highest such ballot and set z to h.x.
      confirm_candidates = setof(ballot, ballot in prepare_points(state), ballot > state.h, confirms_prepare(state, ballot))

      if confirm_candidates:
        state.h = max(confirm_candidates)
        state.z = state.h.x

      # (3) If phi = PREPARE, c = 0, b ≤ h, and neither p ⋧ h nor p2 ⋧ h, then set c to the lowest
      # ballot satisfying b ≤ c ≲ h.
      if state.c.n == 0 and state.b <= state.h and not(state.p.gt_nc(state.h) or state.p2.gt_nc(state.h)):
        c = Ballot(state.b.n, state.h.x)
        state.c = c if c >= state.b else Ballot(state.b.n + 1, state.h.x)

      # (4) If phi = PREPARE and v accepts commit for one or more ballots, set c to the lowest
      # such ballot, then set h to the highest ballot such that v accepts all { commit b2 ∣
      # c ≲ b2 ≲ h }, and set phi to CONFIRM. Also set z to h.x after updating h, and unless
      # h ≲ b, set b to h.
      points = commit_points_all(state)
      accepted = setof(ballot, ballot in points, accepts_commit(state, ballot))
      if accepted:
        state.c = min(accepted)
        state.h = max(setof(h, h in accepted, state.c.lt_c(h), accepts_commit_range(accepted, points, state.c, h)))
        state.z = state.h.x
        state.phi = 'CONFIRM'
        if not state.h.lt_c(state.b): state.b = state.h

    # (5) If phi = CONFIRM and the received message lets v accept new ballots prepared,
    # raise p to the highest accepted prepared ballot such that p ∼ c.
    if state.phi == 'CONFIRM':
      p_candidates = setof(ballot, ballot in prepare_points(state), ballot.x == state.c.x, ballot > state.p, accepts_prepare(state, ballot))
      if p_candidates: state.p = max(p_candidates)

      # (6) If phi = CONFIRM and v accepts more commit messages or raises b, then let h2 be
      # the highest ballot such that v accepts all { commit b2 ∣ b ≲ b2 ≲ h2 } (if any). If
      # there exists such an h2 and h2 > h, then set h to h2, and, if necessary, raise c to
      # the lowest ballot such that v accepts all { commit b2 ∣ c ≲ b2 ≲ h }.
      points = commit_points_all(state)
      accepted = setof(ballot, ballot in points, accepts_commit(state, ballot))
      h2_candidates = setof(h2, h2 in accepted, state.b.lt_c(h2), accepts_commit_range(accepted, points, state.b, h2))
      if h2_candidates and max(h2_candidates) > state.h:
        state.h = max(h2_candidates) #? we're changing h but not changing z with it.
        lowest_c = minof(c2, c2 in accepted, c2.lt_c(state.h), accepts_commit_range(accepted, points, c2, state.h))
        state.c = max(state.c, lowest_c)

      # (7) If phi = CONFIRM and v confirms commit c2 for any c2, set c and h to the lowest and
      # highest such ballots, set phi to EXTERNALIZE, externalize c.x, and terminate.
      confirmed = setof(c2, c2 in points, confirms_commit(state, c2))
      if confirmed:
        state.c, state.h = min(confirmed), max(confirmed)
        state.phi = 'EXTERNALIZE'
        log(f'{self} externalized {state.c.x} for slot {state.slot} with c={state.c} h={state.h}')

    # (8) If phi ∈ {PREPARE, CONFIRM} and b < h, then set b to h.
    if state.phi in ('PREPARE', 'CONFIRM'):
      if state.b < state.h: state.b = state.h

      # (9) If phi ∈ {PREPARE, CONFIRM} and ∃S ⊆ Mv such that the set of senders { vm2 ∣
      # m2 ∈ S } is v-blocking and ∀m2 ∈ S, b_m2.n > b_v.n, then set b to ⟨n, z⟩, where n is
      # the lowest counter for which no such S exists. Repeat the previous steps after
      # updating b
      ## such an S exists iff all senders ahead of the counter are v-blocking
      sender_counters = setof((str(vm), INFINITY if t == 'EXTERNALIZE' else f[0].n), (t, vm, _, f, _) in state.M)
      if qc.v_blocking(setof(vm, (vm, bn) in sender_counters, bn > state.b.n)):
        n = minof(n2, (_, n2) in sender_counters, not qc.v_blocking(setof(vm, (vm, bn) in sender_counters, bn > n2)))
        state.b = Ballot(n, state.z)
        update_state(state)
  
  def arm_timer(state:State, kind, duration):
    t = Timer(duration, send, args=(('timeout', state.slot, kind, state.b.n),), kwargs={'to': {self}})
    t.daemon = True
    t.start()

  def receive(msg=('timeout', i, kind, n), from_=self):
    state = self.state_per_slot[i]
    if kind == 'nomination': increment_n(state)
    elif state.phi != 'EXTERNALIZE' and state.b.n == n: increment_ballot(state)

  def increment_ballot(state:State):
    # (b) If the timer fires, v updates its ballot by setting b_v ← ⟨b_v.n + 1, z_v⟩.
    state.b = Ballot(state.b.n + 1, state.z)
    update_state(state)
    send_message(state)

  def run():
    await(False)

class Client(process):
  def setup(nodes:dict):
    pass

  def run():
    time.sleep(0.05)
    send(('TRANSACTION', 1, 'A'), to=set(nodes.values()))
    # send(('TRANSACTION', 1, 'B'), to={ nodes['bob'] })
    # send(('TRANSACTION', 1, 'C'), to={ nodes['carol'] })
    # send(('TRANSACTION', 1, 'D'), to={ nodes['dave'] })
    # send(('TRANSACTION', 1, 'E'), to={ nodes['eve'] })
    # send(('TRANSACTION', 1, 'F'), to={ nodes['frank'] })

def main():
  _TOP4 = {'alice', 'bob', 'carol', 'dave'}
  _MID4 = {'eve', 'frank', 'grace', 'heidi'}
  QUORUM_CONFIG = {
    'alice': (3, _TOP4),
    'bob':   (3, _TOP4),
    'carol': (3, _TOP4),
    'dave':  (3, _TOP4),

    'eve':   (2, _TOP4),
    'frank': (2, _TOP4),
    'grace': (2, _TOP4),
    'heidi': (2, _TOP4),

    'ivan':  (2, _MID4),
    'judy':  (2, _MID4),
  }

  all_nodes = new(SCPNode, num=len(QUORUM_CONFIG))
  nodes = dict(zip(QUORUM_CONFIG.keys(), all_nodes))
  clients = new(Client, [nodes], num=1)

  debug_names = {str(pid): name for name, pid in nodes.items()} ## lets output() replace raw node ids with names in log lines
  log_file = f'scp_log_{datetime.now().strftime("%Y%m%dT%H%M%S")}.txt' 
  output(f'created nodes: {nodes}')
  for node, config in QUORUM_CONFIG.items():
    setup(nodes[node], [quorum.build_D(config, nodes), set(all_nodes), node, debug_names, log_file])

  start(nodes.values())
  start(clients)
  ## await(False)
  ## time.sleep(0.2)
  ## end(all_nodes)
