from scp import Node, QUORUM_CONFIG
from utils import hash_msg
from datetime import datetime

class NodeX(process, Node):
  def setup(D, checker):
    super().setup(D)
    self.c = 0

  def receive(msg=('send', m, to), from_=checker):
    super().send(m, to=to)

  def receive(msg=m, from_=self.peers):
    self.c += 1
    msg = (f'received', self, self.c, m)
    send(msg, to=checker)

  def run():
    await(False)

class Checker(process):
  def setup(nodes):
    self.alice = nodes['alice'][0]
    self.bob = nodes['bob'][0]
    self.carol = nodes['carol'][0]
    self.d_alice = nodes['alice'][1]
    self.d_bob = nodes['bob'][1]
    self.d_carol = nodes['carol'][1]
    pass

  def write_results(test_name, results):
    with open('test_results.txt', 'a') as f:
      f.write(f'[{datetime.now().isoformat()}] {test_name}: {results}\n')

  def test_gossip():
    m = ('NOMINATE', self.alice, 1, frozenset({'x'}), frozenset(), self.d_alice)

    # first send: alice -> bob only
    send(('send', m, {self.bob}), to=self.alice)
    await timeout(1)

    # second send of the *same* message: bob repeated, carol new
    send(('send', m, {self.bob, self.carol}), to=self.alice)
    await timeout(1)

    bob_hits = setof(c, received(('received', self.bob, c, m)))
    carol_hits = setof(c, received(('received', self.carol, c, m)))
    output(f'bob received {m} {len(bob_hits)} time(s) (expect 1)')
    output(f'carol received {m} {len(carol_hits)} time(s) (expect 1)')

    passed = len(bob_hits) == 1 and len(carol_hits) == 1
    write_results('test_gossip', {
      'bob_hits': len(bob_hits),
      'carol_hits': len(carol_hits),
      'passed': passed,
    })

  def run():
    test_gossip()
    await(False)
    
def main():

  all_nodes = new(NodeX, num=len(QUORUM_CONFIG))
  nodes = dict(zip(QUORUM_CONFIG.keys(), all_nodes))
  nodes_w_D = dict()
  output(f'created nodes: {nodes}')
  checker = new(Checker, num=1)

  for node, config in QUORUM_CONFIG.items():
    ## Build D as a tuple: (outer_threshold, ((inner_threshold, validators), ...))
    inner_slices = tuple(
      (s['threshold'], frozenset(nodes[name] for name in s['validators']))
      for s in config['slices']
    )
    D = (config['threshold'], inner_slices)
    nodes_w_D[node] = (nodes[node], D)
    setup(nodes[node], [D, checker]) ## assuming that nodes start out only knowing the nodes in their quorum config and know no other nodes
  
  setup(checker, [nodes_w_D])

  start(nodes.values())
  start(checker)

