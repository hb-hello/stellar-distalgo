import quorum

## Owns the lifecycle of a test round's node processes 
class NodeManager(process):
  def setup():
    self.nodes = {}
    self.debug_names = {}
    self.ready_nodes = set()
    self.done_nodes = set()
    self.crashed_nodes = set()
    self.node_Ds = {}

  def receive(msg=(tid, 'ready'), from_=source):
    self.ready_nodes.add(source)

  def receive(msg=(tid, 'done'), from_=source):
    self.done_nodes.add(source)

  ## Spawn a fresh batch of `node_cls` processes for one test round, tagged with
  ## `test_id`. 
  def spawn_nodes(quorum_config, node_cls, test_id, log_file, crashed=(), node_args={}):
    self.ready_nodes = set()
    self.done_nodes = set()
    all_nodes = new(node_cls, num=len(quorum_config))
    self.nodes = dict(zip(quorum_config.keys(), all_nodes))
    self.debug_names = {str(pid): node_name for node_name, pid in nodes.items()}
    self.crashed_nodes = setof(nodes[n], n in crashed)
    for node_name, config in quorum_config.items():
      D = quorum.build_D(config, nodes)
      self.node_Ds[nodes[node_name]] = D
      setup(nodes[node_name], [D, set(all_nodes), self, node_name, debug_names, log_file, test_id, node_name in crashed, *node_args.get(node_name, ())])
    start(nodes.values())
    await(len(self.ready_nodes) == len(quorum_config) - len(crashed_nodes))
    output(f'spawned nodes for test {test_id}: {nodes}')

  def teardown_nodes():
    send(('terminate',), to=set(nodes.values()))
    await(len(self.done_nodes) == len(nodes) - len(crashed_nodes))
    self.nodes = {}
    self.crashed_nodes = set()
    self.node_Ds = {}
