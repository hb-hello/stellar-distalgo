QUORUM_CONFIG = {
  'alice': {'threshold': 1, 'slices': [{'threshold': 2, 'validators': {'alice', 'bob', 'carol'}}]},
  'bob':   {'threshold': 1, 'slices': [{'threshold': 2, 'validators': {'alice', 'bob', 'carol'}}]},
  'carol': {'threshold': 1, 'slices': [{'threshold': 2, 'validators': {'alice', 'bob', 'carol'}}]},
}

## Both tiers reference the SAME full 8-node top-tier validator set (alice..heidi), just
## at different thresholds: alice/bob/carol/dave need 5-of-8, eve/frank/grace/heidi need
## 6-of-8. Since every node's D lists all 8 names, everyone is directly peered with
## everyone else (no gossip relay needed to cross tiers) - unlike an earlier version of
## this config that made a separate node's independent vote mandatory via a nested AND
## slice, which meant ratification (Y->Z) could never succeed because that node's own
## nomination view rarely converged on the same value (nodes never got past X/Y - no
## slot ever produced a candidate). Here, quorum intersection is via plain pigeonhole:
## every valid quorum needs >=6-of-8 (5-of-8 alone is never enough once any 6-threshold
## member is present, and there aren't enough non-top nodes to substitute), so any two
## quorums share >=4 members - and because those members vote directly (not through an
## uninvolved third party), the shared members' own accept_nominate votes are exactly
## what's needed to ratify. The two thresholds (5 vs 6) still give alice/bob/carol/dave
## and eve/frank/grace/heidi different weight() values off the same candidate pool, so
## their locally-computed max-priority neighbor can still diverge round to round.
_TOP8 = {'alice', 'bob', 'carol', 'dave', 'eve', 'frank', 'grace', 'heidi'}
DISJOINT_LEADERS_CONFIG = {
  'alice': {'threshold': 1, 'slices': [{'threshold': 5, 'validators': _TOP8}]},
  'bob':   {'threshold': 1, 'slices': [{'threshold': 5, 'validators': _TOP8}]},
  'carol': {'threshold': 1, 'slices': [{'threshold': 5, 'validators': _TOP8}]},
  'dave':  {'threshold': 1, 'slices': [{'threshold': 5, 'validators': _TOP8}]},

  'eve':   {'threshold': 1, 'slices': [{'threshold': 6, 'validators': _TOP8}]},
  'frank': {'threshold': 1, 'slices': [{'threshold': 6, 'validators': _TOP8}]},
  'grace': {'threshold': 1, 'slices': [{'threshold': 6, 'validators': _TOP8}]},
  'heidi': {'threshold': 1, 'slices': [{'threshold': 6, 'validators': _TOP8}]},

  'ivan':  {'threshold': 1, 'slices': [{'threshold': 2, 'validators': {'alice', 'bob', 'eve', 'frank'}}]},
  'judy':  {'threshold': 1, 'slices': [{'threshold': 2, 'validators': {'carol', 'dave', 'grace', 'heidi'}}]},
}

## Owns the lifecycle of a test round's node processes 
class NodeManager(process):
  def setup():
    self.nodes = {}
    self.debug_names = {}
    self.ready_nodes = set()
    self.done_nodes = set()

  def receive(msg=(tid, 'ready'), from_=source):
    self.ready_nodes.add(source)

  def receive(msg=(tid, 'done'), from_=source):
    self.done_nodes.add(source)

  ## Spawn a fresh batch of `node_cls` processes for one test round, tagged with
  ## `test_id`. 
  def spawn_nodes(quorum_config, node_cls, test_id, log_file):
    self.ready_nodes = set()
    self.done_nodes = set()
    all_nodes = new(node_cls, num=len(quorum_config))
    self.nodes = dict(zip(quorum_config.keys(), all_nodes))
    self.debug_names = {str(pid): node_name for node_name, pid in nodes.items()}
    for node_name, config in quorum_config.items():
      ## Build D as a tuple: (outer_threshold, ((inner_threshold, validators), ...))
      inner_slices = tuple(
        (s['threshold'], frozenset(nodes[n] for n in s['validators']))
        for s in config['slices']
      )
      D = (config['threshold'], inner_slices)
      setup(nodes[node_name], [D, self, node_name, debug_names, log_file, test_id])
    start(nodes.values())
    await(len(self.ready_nodes) == len(quorum_config))
    output(f'spawned nodes for test {test_id}: {nodes}')

  def teardown_nodes():
    send(('terminate',), to=set(nodes.values()))
    await(len(self.done_nodes) == len(nodes))
    self.nodes = {}
