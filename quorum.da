# type: ignore
from itertools import combinations, product
from quorum_intersection import QuorumIntersectionChecker

class QuorumChecker:
  ## v is this checker's own node id; Ds maps str(node) -> D with str leaves, learned from peers' messages
  def __init__(self, v, D):
    self.v = v
    self.Ds = {}
    self.add(v, D)

  def add(self, v, D):
    self.Ds[v] = str_D(D)
    if v == self.v:
      self.slices = slices(self.Ds[v])
      self.members = validators(self.Ds[v])

  # Definition (quorum). A set of nodes U ⊆ V in FBAS ⟨V, Q⟩ is a quorum iff U ≠ ∅ and
  # U contains a slice for each member—i.e., ∀v ∈ U, ∃q ∈ Q(v) such that q ⊆ U.
  def quorum(self, U):
    return self.v in largest_quorum(self.Ds, U)

  # Definition (v-blocking). Let v ∈ V be a node in FBAS ⟨V, Q⟩. A set B ⊆ V is v-blocking
  # iff it overlaps every one of v’s slices—i.e., ∀q ∈ Q(v), q ∩ B ≠ ∅.
  def v_blocking(self, B):
    D = self.Ds[self.v]
    return not satisfied(D, validators(D) - set(B))

  # weight(v, v2) = |{q | q ∈ Q(v) & v2 ∈ q}| / |Q(v)|
  # The function weight (v, v2) returns the fraction of slices in Q(v) containing v2
  def weight(self, v2):
    return len(setof(q, q in self.slices, _v2 in q)) / len(self.slices) if self.slices else 0


def has_quorum_intersection(Q):
  return QuorumIntersectionChecker(Q).has_quorum_intersection()

def is_nested(m):
  return isinstance(m, tuple) and len(m) == 2

## config is (threshold, members) over names - swaps each name for its node id
def build_D(config, nodes):
  t, members = config
  return (t, frozenset(build_D(m, nodes) if is_nested(m) else nodes[m] for m in members))

def str_D(D):
  t, members = D
  return (t, frozenset(str_D(m) if is_nested(m) else str(m) for m in members))

## every slice D allows, as explicit node sets
def slices(D):
  t, members = D
  return setof(frozenset().union(*parts), c in combinations(members, t),
    parts in product(*[slices(m) if is_nested(m) else {frozenset({m})} for m in c]))

def validators(D):
  return set().union(*(validators(m) if is_nested(m) else {m} for m in D[1]))

def satisfied(D, S):
  t, members = D
  return sum(satisfied(m, S) if is_nested(m) else m in S for m in members) >= t

def satisfies(D, S):
  return D is not None and satisfied(D, S)

## shrink S until every member has a slice in it - the largest quorum inside S, or empty
def largest_quorum(Ds, S):
  S = set(S)
  while some(n in S, has=not satisfies(Ds.get(n), S)):
    S = setof(n, n in S, satisfies(Ds.get(n), S))
  return S

## ⟨V,Q⟩^B for one node: B's members count as already satisfied
def delete(D, B):
  t, members = D
  kept = []
  for m in members:
    if is_nested(m): m = delete(m, B)
    if (is_nested(m) and m[0] <= 0) or (not is_nested(m) and m in B): t -= 1
    else: kept.append(m)
  return (max(t, 0), tuple(kept))

# Definition (DSet). Let ⟨V, Q⟩ be an FBAS and B ⊆ V be a set of nodes. We say B is
# dispensible, or a DSet, iff:
# (1) (quorum intersection despite B) ⟨V, Q⟩^B enjoys quorum intersection, and
# (2) (quorum availability despite B) Either V ⧵ B ∈ 𝐐 or B = V.
def is_dset(Ds, B):
  rest = set(Ds) - B
  return not rest or (all(satisfied(Ds[v], rest) for v in rest)
    and has_quorum_intersection({v: delete(Ds[v], B) for v in rest}))

# Definition (intact). A node v in an FBAS is intact iff there exists a DSet B containing
# all ill-behaved nodes and such that v ∉ B.
## every DSet containing ill contains the nodes left without a slice once ill is removed (repeatedly),
## so if that set is itself a DSet it's the minimal one; otherwise search its supersets
def intact_set(Ds, ill):
  B = set(ill)
  while True:
    drop = set(v for v in set(Ds) - B if not satisfied(Ds[v], set(Ds) - B))
    if not drop: break
    B |= drop
  if is_dset(Ds, B): return set(Ds) - B
  rest = list(set(Ds) - B)
  dsets = [B | set(c) for k in range(1, len(rest) + 1) for c in combinations(rest, k) if is_dset(Ds, B | set(c))]
  return set(Ds) - set.intersection(*dsets)
