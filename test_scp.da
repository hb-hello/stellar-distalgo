from scp import SCPNode
from client import Client
from node_manager import NodeManager, QUORUM_CONFIG, DISJOINT_LEADERS_CONFIG
from utils import hash_msg, replace_node_ids
from datetime import datetime
from collections import Counter
from itertools import product

def as_tuple(value):
  return tuple(value) if isinstance(value, (list, tuple, set)) else (value,)

PROTOCOL_MESSAGES = {'NOMINATE'}

class SCPNodeX(process, SCPNode):
  def setup(D, checker, name, debugNames, log_file, test_id):
    super().setup(D, name, debugNames, log_file)
    self.protocol_messages = PROTOCOL_MESSAGES
    self.test_id = test_id

  def send(msg, to, debugOnly=False, withLog=None):
    if checker in to:
      msg = (self.test_id,) + msg
    super().send(msg, to=to, debugOnly=debugOnly, withLog=withLog)

  def receive(msg=('send', m, to), from_=checker):
    super().send(m, to=to)

  def update_nomination_state(state):
    old_z = set(state.Z)
    result = super().update_nomination_state(state)
    new_candidates = state.Z - old_z
    if new_candidates:
      send(('candidate', state.slot, frozenset(new_candidates)), to={ checker })
    return result

  def receive(msg=('terminate',), from_=checker):
    send(('done',), to={ checker })
    exit()

  def run():
    send(('ready',), to={ checker })
    await(False)

class Checker(process, Client, NodeManager):
  def setup(name):
    super().setup()
    self.name = name
    self.log_file = f'scp_log_{datetime.now().strftime("%Y%m%dT%H%M%S")}.txt' 
    self.test_counter = 0

  def output(s):
    super().output(f'[{self.name}] {s}')

  def write_results(test_name, results):
    file_path = 'test_results/scp_checker.txt'
    line = replace_node_ids(results, self.debug_names)
    with open(file_path, 'a') as f:
      f.write(f'[{datetime.now().isoformat()}] {test_name}: {line}\n')

  def next_test_id():
    self.test_counter += 1
    return self.test_counter

  ## Invariant: intact nodes can produce at least one candidate value for slot i,
  ## scoped to just this test round's nodes/messages via test_id.
  def validate_nomination(test_id, i):
    return each(n in self.nodes.values(), has=some(received((_test_id, 'candidate', _i, x), from_=n)))

  ## Each case is (senders, validators, quorum_configs, slot_range); any of the
  ## first three may be a single value or a tuple/list of values, and every
  ## combination across them runs in its own isolated round of freshly spawned
  ## nodes.
  def run_test(cases):
    for senders, validators, quorum_configs, slot_range in cases:
      for sender, validator, quorum_config in product(as_tuple(senders), as_tuple(validators), as_tuple(quorum_configs)):
        test_id = next_test_id()
        spawn_nodes(quorum_config, SCPNodeX, test_id, self.log_file)
        output(f'test {test_id}: {sender.__name__} x {validator.__name__}')
        sender(slot_range, self.nodes)
        for i in slot_range:
          await(validator(test_id, i))
          write_results(f'{sender.__name__} x {validator.__name__}',
                        f'{validator.__name__}({test_id}, {i}) = True')
        teardown_nodes()

  def run():
    run_test([
      (self.send_all_different, self.validate_nomination, (DISJOINT_LEADERS_CONFIG), range(1, 21)),
    ])
    output('all tests done')

def main():
  checker = new(Checker, num=1)
  setup(checker, ['checker'])
  start(checker)
